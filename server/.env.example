# ─────────────────────────────────────────────────────────────────────────────
# FleetVision-AI  —  Server Environment Variables
# Copy this file to server/.env and fill in your keys.
# ─────────────────────────────────────────────────────────────────────────────

# Server port (default: 8787)
PORT=8787

# ── GLM-4.5V (ZhipuAI) ───────────────────────────────────────────────────────
# Get your key at https://open.bigmodel.cn/
GLM_API_KEY=
GLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# Use glm-4.5v for multimodal vision + text (best for road image analysis)
# Also compatible with: glm-4v, glm-4, glm-4-flash
GLM_MODEL=glm-4.5v

# ── YOLO11 Inference Endpoint ─────────────────────────────────────────────────
# Point to a self-hosted Ultralytics YOLO11 server or a cloud inference API.
# When left empty the server runs in demo mode with realistic mock detections.
#
# Self-hosted example (Ultralytics FastAPI wrapper):
#   uvicorn yolo_server:app --host 0.0.0.0 --port 8000
#   YOLO_API_URL=http://localhost:8000/detect
#
# Cloud example (Roboflow hosted):
#   YOLO_API_URL=https://detect.roboflow.com/<your-model>/<version>
YOLO_API_URL=
YOLO_API_KEY=

# ── YOLO11 Detection Categories (all 13 supported) ───────────────────────────
# Your YOLO model should be trained / fine-tuned to output these class names:
#
#   pothole            → R&B Roads Dept (RNB)
#   road_crack         → R&B Roads Dept (RNB)
#   waterlogging       → UEED Drainage (UEED)
#   pedestrian         → J&K Traffic Police (TRAFFIC)
#   car                → J&K Traffic Police (TRAFFIC)
#   bus                → J&K Traffic Police (TRAFFIC)
#   bike               → J&K Traffic Police (TRAFFIC)
#   traffic_congestion → J&K Traffic Police (TRAFFIC)
#   illegal_parking    → J&K Traffic Police (TRAFFIC)
#   debris             → SMC Sanitation (SMC)
#   garbage            → SMC Sanitation (SMC)
#   damaged_sign       → J&K Traffic Police (TRAFFIC)
#   streetlight_failure→ Power Dev. Dept (PDD)

# ── Webhook delivery (optional) ───────────────────────────────────────────────
# POST a structured JSON report to these URLs when an incident is created.
# Leave empty to disable.
AUTHORITY_REPORT_WEBHOOK=
ADMIN_REPORT_WEBHOOK=
